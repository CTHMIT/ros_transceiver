{
  mode: "client",
  connect: {
    endpoints: [
      // Use the placeholder so .env controls this
      "${ZENOH_CONNECT_ENDPOINT}"
    ]
  },
  listen: {
    endpoints: [
      // Use 0 to let the OS pick a random free port. 
      // Hardcoding 7447 here causes "Address in use" errors if you run Server & Client on one machine.
      "tcp/0.0.0.0:0"
    ]
  },
  plugins: {
    ros2dds: {
      domain: 161,
      allow: {
        publishers: [
          "^/tf$",
          "^/tf_static$",
          "^/rosout$",
          "^/nvblox_node/mesh$",
          "^/visual_slam/tracking/odometry$",
          "^/nvblox_node/color_layer$",
          "^/nvblox_node/esdf_slice_bounds$",
          "^/nvblox_node/workspace_bounds$",
          "^/nvblox_node/static_esdf_pointcloud$",
          "^/visual_slam/vis/observations_cloud$",
          "^/camera0/realsense_splitter_node/output/depth$",
          "^/nvblox_node/back_projected_depth/camera_depth_optical_frame$",
          "^/initialpose$",
          "^/goal_pose$",
          "^/clicked_point$"
        ],
      },
      qos: {
        publishers: {
          ".*": {
            reliability: "reliable",
            // CRITICAL FIX: "keep_all" causes massive latency with cameras/lidars if network drops.
            // "keep_last" with depth 1 ensures you always get the latest frame.
            history: "keep_last",
            depth: 1
          }
        }
      },
      discovery: {
        enabled: true
      }
    }
  }
}