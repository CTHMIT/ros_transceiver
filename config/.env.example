# Zenoh Bridge Configuration

# Mode: client or router
ZENOH_BRIDGE_MODE=client

# Connect Endpoint (for Client mode)
# The IP address of the Server PC
ZENOH_CONNECT_ENDPOINT=tcp/10.28.134.82:7447

# Listen Endpoint (for Router mode or Client mode if needed)
ZENOH_LISTEN_ENDPOINT=tcp/0.0.0.0:7447

# ROS 2 Domain ID
ROS_DOMAIN_ID=161
